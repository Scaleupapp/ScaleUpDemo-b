# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/scaleup?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=<random-64-char-string>
JWT_REFRESH_SECRET=<different-random-64-char-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=scaleup-content

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google (OAuth + Gemini)
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Twilio (SMS OTP for phone authentication)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# YouTube Data API
YOUTUBE_API_KEY=

# Email (SES or Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Feature flags
FEATURE_DAY1_DIAGNOSTIC=true

# -----------------------------------------------------------------------------
# Coding / Capstones (Phase B)
# -----------------------------------------------------------------------------

# Sandbox provider — only 'e2b' is wired today. Daytona swap is one env change.
SANDBOX_PROVIDER=e2b

# e2b — required for capstone sandbox provisioning.
E2B_API_KEY=

# Custom locked templates (see infra/e2b-templates/<lang>-locked/). Each is the
# template id returned by `e2b template build --name scaleup-<lang>-locked`.
# Leave blank ONLY in dev. Production MUST set all three.
E2B_TEMPLATE_NODE=
E2B_TEMPLATE_PYTHON=
E2B_TEMPLATE_JAVA=

# Enforce that every provisioned sandbox shows the iptables lockdown marker.
# Set to 'true' in production. When true and the marker is missing, the
# orchestrator aborts the session and fires sandbox.egress-not-locked alert.
E2B_REQUIRE_EGRESS_LOCKDOWN=false

# Warm pool sizes (per image, defaults: js=1, py=1, ts=1, java=0, sql=0).
# Bump for peak hours.
# CAPSTONE_WARM_POOL_JAVASCRIPT=3
# CAPSTONE_WARM_POOL_PYTHON=3

# Compass-Coder daily per-user USD ceiling (turn endpoint enforces).
COMPASS_CODER_DAILY_USD_CEILING=2.00

# Capstone evaluator caps (per-session budget).
CAPSTONE_EVAL_PER_SESSION_USD_CEILING=1.00

# Alerts — Slack-compatible incoming webhook. Leave blank to log-only.
ALERT_WEBHOOK_URL=
ALERT_DEDUP_WINDOW_MS=600000

# Cost alarm thresholds.
COST_ALERT_PER_SESSION_USD=1.00
COST_ALERT_DAILY_USD=50.00

# Voice reflection (Whisper transcription, S3 stash).
OPENAI_WHISPER_MODEL=whisper-1
S3_VOICE_REFLECTION_PREFIX=capstone/voice-reflections/

# -----------------------------------------------------------------------------
# Agentic layer (Plan 1)
# -----------------------------------------------------------------------------

# Per-agent kill switch (pattern: AGENT_<ID>_ENABLED). Default on — set to
# 'false' to disable the Compass Actions agent with zero UX residue.
# AGENT_COMPASS_ACTIONS_ENABLED=false

# Pending agent proposals older than this are marked 'ignored' by the daily
# sweep (see src/workers/cronJobs.js). Default 48 hours.
# AGENT_DECISION_TTL_HOURS=48

# Accepted/adjusted compass_actions proposals older than this get checked for
# implicit follow-through (did the plan changes stick) by the nightly
# agentOutcomeClosure sweep (see src/workers/cronJobs.js). Default 24 hours.
# AGENT_OUTCOME_CLOSURE_MIN_HOURS=24

# Author agent (Plan 3): max regenerateQuestion repair passes per authoring
# run over questions flagged low-confidence by the QA solver gate (see
# authorAgentService.js). Default 2.
# AUTHOR_AGENT_MAX_REPAIR_PASSES=2

# Author agent orphan reaper (see authorAgentService.js reapOrphanedRuns,
# cron in src/workers/cronJobs.js runs every 15 min): an author_agent
# AgentDecision row still unfinished (action.result null) after this many
# minutes is assumed to be orphaned by a dead process/server restart, not a
# slow run, and is closed out as 'failed' so the assessment isn't stuck
# forever behind the in-flight guard. Default 30.
# AUTHOR_AGENT_ORPHAN_MINUTES=30

# Capstone/drill authoring poll budget (see assessmentAuthoringService.js
# authorCapstone/authorDrill): how long to keep polling a generation request
# for ready/failed before treating it as still-running and handing back a
# pending sentinel (never a false CAPSTONE_GEN_FAILED). Real generation
# (Opus writes a repo -> E2B sandbox proof -> Gemini cross-check) takes
# ~7+ minutes; default 12 leaves comfortable margin. A run left pending past
# this budget is closed out by the authorAgentBundleReconciler cron
# (src/workers/cronJobs.js, every 2 min; see authorAgentService.js
# reconcileBundleRuns), which has its own separate, longer abandonment
# window (default 30 min) before it gives up.
# CAPSTONE_AUTHOR_POLL_MINUTES=12

# Activation agent (Plan 4, #10): caps on the daily invite re-nudge job (see
# activationAgentService.js). A student stops being nudged once remindersSent
# hits the max; each nudge waits at least the gap since the last one (or the
# original invite, for a never-yet-reminded student).
# ACTIVATION_MAX_REMINDERS=3
# ACTIVATION_REMINDER_GAP_DAYS=3

# Sentinel (ops monitoring): multiplier threshold for spend spike detection.
# SENTINEL_SPEND_SPIKE_FACTOR=2
